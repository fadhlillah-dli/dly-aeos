#!/bin/sh
# git post-merge hook (runs after git pull or git merge; not after git pull --rebase): prints a reminder when the
# merge changed frontend/ or backend/. A running './aeos serve' keeps the code it loaded and the UI bundle it found at
# start; a restart rebuilds a stale bundle once and loads the new backend. It only prints and never fails.
# Install once per clone: git config core.hooksPath scripts/git-hooks
changed=$(git diff --name-only ORIG_HEAD HEAD -- frontend backend 2>/dev/null) || exit 0
if [ -n "$changed" ]; then
  echo "post-merge: frontend/backend changed: restart ./aeos serve (Windows: .\\aeos.ps1 serve)"
fi
exit 0
