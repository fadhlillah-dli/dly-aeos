{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeos.worker.report.v1",
  "title": "aeos.worker.report",
  "description": "Structured message from a worker to the AEOS control plane (untrusted DATA).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "task_key": {
      "type": "string",
      "maxLength": 200
    },
    "run_id": {
      "type": "string",
      "maxLength": 200
    },
    "plan_version_hash": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "enum": [
        "COMPLETED",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "detail": {
            "type": "string",
            "maxLength": 2000
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "blocker": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "enum": [
            "SCOPE_GROWTH",
            "CONTRACT_UNMET",
            "MISSING_INPUT",
            "NEEDS_DECISION",
            "OTHER"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "requested_decision": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "reason"
      ],
      "properties": {
        "kind": {
          "enum": [
            "POLICY",
            "RISK_ACCEPTANCE",
            "EXCEPTION",
            "BUDGET"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        },
        "requested_operations": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
