{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dly-aeos:install-manifest:1",
  "title": "DLY AEOS InstallManifest",
  "description": "Reviewed component catalog (master §07, §13, §37, §45). DESIGN lens only: never installation, connection, evaluation or usage evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "status", "title", "master_ref", "sources_checked", "categories", "components"],
  "properties": {
    "manifest_version": {"type": "string", "pattern": "^[0-9]+$"},
    "status": {"const": "DESIGN"},
    "title": {"type": "string", "minLength": 1},
    "master_ref": {"type": "string", "minLength": 1},
    "sources_checked": {"type": "string", "minLength": 4},
    "reviewed_by": {"type": ["string", "null"]},
    "categories": {
      "type": "array",
      "items": {"$ref": "#/$defs/category"},
      "uniqueItems": true,
      "minItems": 7
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "category": {
      "enum": [
        "experience/intake",
        "planning/governance",
        "workforce",
        "tools/context",
        "code/docs/CI",
        "data/secrets",
        "operations/evaluation"
      ]
    },
    "domain": {"enum": ["PLATFORM", "PERSONAL", "OFFICE"]},
    "relation_type": {
      "enum": [
        "depends_on", "calls", "reads", "writes", "publishes_to", "verifies", "stores_in",
        "runs_with", "implements", "governed_by", "replaces", "alternative_to"
      ]
    },
    "operation": {"enum": ["READ", "WRITE", "READ_WRITE", "CALL", "EXEC", "NONE"]},
    "source_ref": {"type": "string", "pattern": "^S[0-9]{2}$"},
    "component_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "nullable_text": {"type": ["string", "null"]},
    "sha256_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "distribution": {
      "$comment": "§37: the distribution artifact is its own identity (not the source repo, not the binary on PATH).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["release_asset", "package_manager", "installer", "os_component", "saas", "source_checkout",
                          "pypi", "npm", "none", "unknown"]},
        "url": {"type": ["string", "null"], "pattern": "^https://"},
        "digest": {"$ref": "#/$defs/sha256_digest"},
        "channel": {"$ref": "#/$defs/nullable_text"},
        "note": {"$ref": "#/$defs/nullable_text"}
      }
    },
    "signature": {
      "$comment": "§25 tool admission: signature/provenance 'bila tersedia'; UNAVAILABLE/UNKNOWN recorded explicitly.",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "result"],
      "properties": {
        "method": {"enum": ["gpg", "sigstore", "authenticode", "notarization", "checksum_only", "none", "unknown"]},
        "available": {"type": ["boolean", "null"]},
        "verified": {"type": "boolean"},
        "verified_at": {"$ref": "#/$defs/nullable_text"},
        "result": {"enum": ["VERIFIED", "NOT_VERIFIED", "UNAVAILABLE", "UNKNOWN"]},
        "approved_signer": {
          "$comment": "Owner-pinned publisher identity (Authenticode signer subject substring / macOS TeamIdentifier). null = not pinned: a valid signature is reported but authenticity stays UNVERIFIED; a different observed signer BLOCKS the component (§12, §25).",
          "$ref": "#/$defs/nullable_text"
        },
        "note": {"$ref": "#/$defs/nullable_text"}
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "host"],
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "host": {"enum": ["127.0.0.1", "::1", "localhost"]},
        "setting": {"type": ["string", "null"], "pattern": "^[a-z_]{1,64}$"},
        "purpose": {"type": "string"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {"type": "array", "items": {"enum": ["windows", "macos", "linux"]}, "uniqueItems": true},
        "arch": {"type": "array", "items": {"type": "string"}},
        "min_version": {"$ref": "#/$defs/nullable_text"},
        "max_version": {"$ref": "#/$defs/nullable_text"},
        "source": {"$ref": "#/$defs/nullable_text"},
        "note": {"$ref": "#/$defs/nullable_text"}
      }
    },
    "binary_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version_args"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "settings_override": {"type": ["string", "null"], "pattern": "^[a-z_]{1,64}$"},
        "version_args": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._=-]{1,32}$"}, "maxItems": 4},
        "version_regex": {"type": "string"}
      }
    },
    "probe": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "binary", "python_runtime", "python_module", "python_package", "platform_module", "npm_package",
            "repo_file", "git_repo", "sqlite", "keyring_backend", "data_dir", "none"
          ]
        },
        "binaries": {"type": "array", "items": {"$ref": "#/$defs/binary_probe"}, "minItems": 1},
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["settings_url", "path"],
          "properties": {
            "settings_url": {"type": "string", "pattern": "^[a-z_]{1,64}$"},
            "path": {"type": "string", "pattern": "^/[A-Za-z0-9/_.-]*$"},
            "expect": {"type": "string"}
          }
        },
        "scrub_env_prefixes": {"type": "array", "items": {"type": "string"}},
        "module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
        "distribution": {"type": "string"},
        "package": {"type": "string"},
        "impl_modules": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"}},
        "path": {"type": "string", "not": {"pattern": "(^/|^[A-Za-z]:|\\.\\.)"}},
        "min_version": {"type": "string"},
        "reason": {"type": "string"},
        "local_install": {"type": "boolean"},
        "require_entries": {"type": "boolean"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "ttl_seconds": {"type": "integer", "minimum": 60}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "binary"}}}, "then": {"required": ["binaries"]}},
        {"if": {"properties": {"type": {"const": "none"}}}, "then": {"required": ["reason"]}},
        {"if": {"properties": {"type": {"enum": ["python_module"]}}}, "then": {"required": ["module"]}},
        {"if": {"properties": {"type": {"enum": ["python_package"]}}}, "then": {"required": ["distribution"]}},
        {"if": {"properties": {"type": {"enum": ["platform_module", "npm_package"]}}}, "then": {"required": ["package"]}},
        {"if": {"properties": {"type": {"enum": ["repo_file", "data_dir"]}}}, "then": {"required": ["path"]}}
      ]
    },
    "capability_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "functional", "requires_authorization"],
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"},
        "functional": {"type": "boolean"},
        "requires_authorization": {"type": "boolean"},
        "evidence": {"type": "string"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "relation", "data_description"],
      "properties": {
        "target": {"$ref": "#/$defs/component_id"},
        "relation": {"$ref": "#/$defs/relation_type"},
        "data_description": {"type": "string", "minLength": 1},
        "operation": {"$ref": "#/$defs/operation"},
        "boundary": {"$ref": "#/$defs/nullable_text"},
        "identity_ref": {"$ref": "#/$defs/nullable_text"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id", "kind", "name", "friendly_name", "function", "why_selected", "category", "domains",
        "usage_role", "source_kind", "source_url", "source_refs", "upstream_identity", "identity_verified",
        "license", "requirement", "design_label", "bootstrap_order", "approved_pin", "probe", "capability_tests",
        "access", "cost", "operations", "placement", "relations"
      ],
      "properties": {
        "component_id": {"$ref": "#/$defs/component_id"},
        "kind": {
          "enum": [
            "repository", "service", "platform_module", "executable", "worker_engine", "runtime", "package",
            "model_provider", "model_gateway", "mcp_server", "integration", "datastore", "secret_store", "sandbox",
            "method_reference", "skill_library", "orchestrator", "observability", "evaluation", "test_tool",
            "release_mode", "manifest"
          ]
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "friendly_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "function": {"type": "string", "minLength": 1},
        "why_selected": {"type": "string", "minLength": 1},
        "category": {"$ref": "#/$defs/category"},
        "domains": {"type": "array", "items": {"$ref": "#/$defs/domain"}, "minItems": 1, "uniqueItems": true},
        "usage_role": {"enum": ["runtime", "build", "dev", "test", "reference"]},
        "source_kind": {
          "enum": [
            "GITHUB_REPO", "OFFICIAL_DOCS", "OFFICIAL_DISTRIBUTION", "PACKAGE_REGISTRY", "PLATFORM_SOURCE",
            "SAAS_PROVIDER", "OS_COMPONENT", "UNKNOWN"
          ]
        },
        "source_url": {"type": ["string", "null"], "pattern": "^https://"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}, "uniqueItems": true},
        "upstream_identity": {"$ref": "#/$defs/nullable_text"},
        "identity_verified": {"enum": ["VERIFIED", "UNVERIFIED"]},
        "license": {"type": ["string", "null"]},
        "requirement": {"enum": ["REQUIRED", "OPTIONAL", "CANDIDATE", "REFERENCE_ONLY"]},
        "design_label": {
          "enum": [
            "PLANNED", "SELECTED_DESIGN", "PROFILE_DESIGN", "OPTIONAL_CANDIDATE", "CANDIDATE", "REFERENCE_ONLY",
            "UNVERIFIED", "WATCHLIST"
          ]
        },
        "bootstrap_order": {"type": ["integer", "null"], "minimum": 0, "maximum": 11},
        "approved_pin": {"type": ["string", "null"], "minLength": 1, "not": {"type": "string", "pattern": "[Ll][Aa][Tt][Ee][Ss][Tt]"}},
        "approved_digest": {"$ref": "#/$defs/sha256_digest"},
        "distribution": {"$ref": "#/$defs/distribution"},
        "signature": {"$ref": "#/$defs/signature"},
        "ports": {"type": "array", "items": {"$ref": "#/$defs/port"}},
        "config_refs": {"type": "array", "items": {"type": "string",
                                                   "pattern": "^(settings:[a-z_]{1,64}|file:[A-Za-z0-9_./-]{1,200})$"}},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "tool_schema_hash": {"$ref": "#/$defs/sha256_digest"},
        "probe": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/probe"}]},
        "capability_tests": {"type": "array", "items": {"$ref": "#/$defs/capability_test"}},
        "access": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paths": {"type": "array", "items": {"type": "string"}},
            "egress": {"type": "array", "items": {"type": "string"}},
            "data_classes": {"type": "array", "items": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]}},
            "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
            "identity_ref": {"$ref": "#/$defs/nullable_text"},
            "tenant_target": {"$ref": "#/$defs/nullable_text"}
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model"],
          "properties": {
            "model": {"enum": ["NONE", "SUBSCRIPTION", "FREE_TIER", "METERED_API", "COMPUTE", "UNKNOWN"]},
            "amount": {"type": ["number", "null"]},
            "note": {"$ref": "#/$defs/nullable_text"},
            "source": {"$ref": "#/$defs/nullable_text"},
            "free_until": {"type": ["string", "null"], "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}|UNKNOWN)$"}
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "health": {"type": "string"},
            "restart": {"type": "string"},
            "uninstall": {"type": "string"},
            "recovery": {"type": "string"},
            "rollback": {"type": "string"},
            "retention": {"type": "string"},
            "support_status": {"enum": ["SUPPORTED", "UNSUPPORTED", "UNKNOWN"]},
            "install": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "note"],
              "properties": {"kind": {"const": "manual"}, "note": {"type": "string"}}
            }
          }
        },
        "placement": {"type": "string", "minLength": 1},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": {"type": "array", "items": {"type": "string"}},
            "npm": {"type": "array", "items": {"type": "string"}},
            "mcp": {"type": "array", "items": {"type": "string"}},
            "binaries": {"type": "array", "items": {"type": "string"}},
            "actions": {"type": "array", "items": {"type": "string"}}
          }
        },
        "invalidators": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_]+(:[A-Za-z0-9_./*-]+)?$"}},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "$comment": "VERIFIED identity only with a canonical URL from the master (§37).",
          "if": {"properties": {"source_url": {"type": "null"}}},
          "then": {"properties": {"identity_verified": {"const": "UNVERIFIED"}}}
        },
        {
          "$comment": "UNVERIFIED components never carry an install operation (§37: no active install button).",
          "if": {"properties": {"identity_verified": {"const": "UNVERIFIED"}}, "required": ["identity_verified"]},
          "then": {"properties": {"operations": {"not": {"required": ["install"]}}}}
        },
        {
          "$comment": "Candidates/references never carry an install operation either.",
          "if": {"properties": {"requirement": {"enum": ["CANDIDATE", "REFERENCE_ONLY"]}}},
          "then": {"properties": {"operations": {"not": {"required": ["install"]}}}}
        },
        {
          "$comment": "Design label UNVERIFIED implies an unverified identity and no URL.",
          "if": {"properties": {"design_label": {"const": "UNVERIFIED"}}},
          "then": {"properties": {"identity_verified": {"const": "UNVERIFIED"}, "source_url": {"type": "null"}}}
        }
      ]
    }
  }
}
